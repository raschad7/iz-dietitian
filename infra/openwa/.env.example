# Copy to infra/openwa/.env — that file is git-ignored.
#
# Only one value is required. Everything else about the gateway is set in
# docker-compose.yml next to this file.

# The gateway's master API key: the credential that lets this app (or anyone who
# can reach port 2785) send WhatsApp messages from the clinic's number. Treat it
# like a password.
#
#   openssl rand -hex 32
#
# The same value goes into WHATSAPP_API_KEY in the app's .env.local.
API_MASTER_KEY=

# Optional. `info` is the default; `debug` prints every engine event, which is what
# you want while a QR scan is failing and nothing else explains why.
LOG_LEVEL=info
