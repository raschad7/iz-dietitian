# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# lockfiles from other package managers — this project uses Bun
package-lock.json
pnpm-lock.yaml
yarn.lock

# env — every environment file stays local, templates included. `.env.example`
# has no leading slash, so it matches at any depth (the root one and
# infra/openwa/.env.example alike).
.env
.env.local
.env.*.local
.env.example

# WhatsApp gateway (infra/openwa) — its own env file and, more importantly, the
# linked WhatsApp session data. Never commit either.
/infra/openwa/.env
/infra/openwa/data/

# typescript
*.tsbuildinfo

# claude code — shared config is committed, personal overrides are not
.claude/settings.local.json

# misc
.DS_Store
*.pem
/coverage
.vercel
