# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# lockfiles from other package managers — this project uses Bun
package-lock.json
pnpm-lock.yaml
yarn.lock

# env — .env.example is the committed template, so it is deliberately not listed.
# (It stays committed because the README's setup step is `cp .env.example .env.local`.)
.env
.env.local
.env.*.local

# WhatsApp gateway (infra/openwa) — its own env file and, more importantly, the
# linked WhatsApp session data. Never commit either.
/infra/openwa/.env
/infra/openwa/data/

# typescript
*.tsbuildinfo

# claude code — shared config is committed, personal overrides are not
.claude/settings.local.json

# superpowers brainstorming scratch — mockups, not source
.superpowers/

# misc
.DS_Store
*.pem
/coverage
.vercel
