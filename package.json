{
  "name": "dietitian-software",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns=\"e2e/**\"",
    "test:e2e": "playwright test",
    "db:migrate:test": "bun --env-file=.env.test.local run scripts/db-migrate-test.ts",
    "db:reset:test": "bun --env-file=.env.test.local run scripts/db-reset-test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run scripts/seed.ts",
    "db:seed:dishes": "bun run scripts/seed-dishes.ts",
    "db:seed:catalog": "bun run scripts/seed-catalog-foods.ts",
    "db:setup": "bun run scripts/setup-database.ts",
    "db:check": "bun run scripts/check-catalog-readiness.ts",
    "db:build-catalog": "bun run scripts/build-catalog-dataset.ts",
    "db:build-food-dataset": "bun run scripts/build-food-dataset.ts",
    "db:reset": "bun run scripts/db-reset.ts",
    "db:backfill:plan-snapshots": "bun run scripts/backfill-plan-nutrition-snapshots.ts",
    "db:backfill:charge-services": "bun run scripts/backfill-charge-services.ts",
    "wa:reminders": "bun run scripts/whatsapp-reminders.ts",
    "brand:build": "bun run scripts/build-brand-assets.tsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/passkey": "1.6.25",
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@react-pdf/renderer": "^4.8.1",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "nprogress": "^0.2.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "resend": "^6.18.1",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.3.3",
    "typescript": "5"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "unrs-resolver"
  ]
}
