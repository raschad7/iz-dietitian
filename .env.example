# Copy to .env.local and fill in. .env.local is git-ignored.
# Bun loads .env.local for `bun run` scripts; Next.js loads it for dev/build.

# Local PostgreSQL (no Docker) — create the database first:
#   createdb dietitian_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dietitian_dev

# Set to "true" to log every SQL statement Drizzle issues.
DRIZZLE_LOG=false

# Better Auth. Generate a secret with: bunx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# Public origin used by the browser auth client.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integration tests read TEST_DATABASE_URL from a separate, git-ignored
# .env.test.local (NOT this file, and NOT .env.local — bun test sets
# NODE_ENV=test, and Bun skips .env.local in that mode, so a value placed
# there would silently never be loaded). It must NOT be the same database as
# DATABASE_URL: the tests truncate every table between tests.
#
# Create .env.test.local (repo root) with:
#   createdb dietitian_test
#   TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dietitian_test

# Transactional email. "console" prints mail to the server console and needs no
# account -- that is the development default, and it is what magic links already
# did. "resend" actually sends, and requires the two values below.
MAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM="Dietitian Clinic <noreply@example.com>"

# Weekly plan generation (meal planning V2).
#
# "console" plans locally from the catalog and needs no key -- that is the test
# default, and it is what lets the generation tests run with no network. "openai"
# actually calls the API.
#
# CAUTION: a shell-level OPENAI_API_KEY takes precedence over this file in both Bun
# and Next.js. If generation returns 401 while the key here looks right, check for a
# stale one in your environment:  echo $OPENAI_API_KEY
LLM_TRANSPORT=openai
OPENAI_API_KEY=
# gpt-4o-mini is the measured default: ~3,100 completion tokens and ~55s for a
# seven-day plan. Any model supporting strict json_schema will work.
OPENAI_MODEL=gpt-4o-mini

# Google sign-in for staff. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials and set the authorised
# redirect URI to: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
