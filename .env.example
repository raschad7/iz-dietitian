# Copy to .env.local and fill in. .env.local is git-ignored.
# Bun loads .env.local for `bun run` scripts; Next.js loads it for dev/build.

# Local PostgreSQL (no Docker) — create the database first:
#   createdb dietitian_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dietitian_dev

# Set to "true" to log every SQL statement Drizzle issues.
DRIZZLE_LOG=false

# Better Auth. Generate a secret with: bunx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# The origin every emailed link is built from -- verification and password
# reset. BETTER_AUTH_URL wins when both are set; APP_URL is the fallback, so a
# deployment that only names one origin still produces links that resolve. Get
# this wrong in production and every link in every inbox points at localhost.
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Public origin used by the browser auth client.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integration tests read TEST_DATABASE_URL from a separate, git-ignored
# .env.test.local (NOT this file, and NOT .env.local — bun test sets
# NODE_ENV=test, and Bun skips .env.local in that mode, so a value placed
# there would silently never be loaded). It must NOT be the same database as
# DATABASE_URL: the tests truncate every table between tests.
#
# Create .env.test.local (repo root) with:
#   createdb dietitian_test
#   TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dietitian_test

# Transactional email. "console" prints mail to the server console and needs no
# account -- that is the development default. "resend" actually sends, and
# requires the two values below.
#
# SIGN-UP DEPENDS ON THIS. A practitioner cannot sign in until they open the
# link mailed to them (REQUIRE_EMAIL_VERIFICATION in src/lib/auth.ts), so any
# deployment left on "console" creates accounts nobody can reach. Locally that
# is fine -- copy the link out of the terminal.
MAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM="Dietitian Clinic <noreply@example.com>"

# Weekly plan generation (meal planning V2).
#
# "console" plans locally from the catalog and needs no key -- that is the test
# default, and it is what lets the generation tests run with no network. "openai"
# actually calls the API.
#
# CAUTION: a shell-level OPENAI_API_KEY takes precedence over this file in both Bun
# and Next.js. If generation returns 401 while the key here looks right, check for a
# stale one in your environment:  echo $OPENAI_API_KEY
LLM_TRANSPORT=openai
OPENAI_API_KEY=
# gpt-4o-mini is the measured default: ~3,100 completion tokens and ~55s for a
# seven-day plan. Any model supporting strict json_schema will work.
OPENAI_MODEL=gpt-4o-mini

# Web Push notifications for the client portal (native Web Push + VAPID, no
# Firebase). With these unset the app behaves exactly as it did before the
# feature existed: the "Notifications on this device" switch is not rendered,
# and nothing is ever sent.
#
# Generate the keypair ONCE per deployment and keep it:
#   bunx web-push generate-vapid-keys --json
#
# WARNING: rotating it invalidates every subscription already stored. Every
# client would have to switch notifications on again, and until they did, their
# phone would go quiet without saying so.
#
# The public half is NEXT_PUBLIC_ because the browser subscribes with it -- that
# is what a public key is for. The private half must never carry that prefix.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# How a push service reaches whoever runs this deployment about its traffic --
# a mailto: or an https: origin (RFC 8292). Optional: falls back to
# BETTER_AUTH_URL / APP_URL, which is a real address for a real person.
VAPID_SUBJECT=

# Bearer token for POST /api/portal/push-reminders, the tick that sends
# appointment reminders and the evening "you have not logged today" nudge.
# Without it that route answers 404 and the tick only runs via
# `bun run push:reminders`.
#   openssl rand -hex 32
PUSH_CRON_SECRET=

# Google sign-in for staff. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials and set the authorised
# redirect URI to: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp automation. Kept in this template deliberately: the README tells you to
# `cp .env.example .env.local`, so deleting it would break the first step of setup.
# See "WhatsApp automation" in the README and infra/openwa/README.md.
# Appointment reminders and confirmations over WhatsApp, through a self-hosted
# OpenWA gateway. Start the gateway with: docker compose -f infra/openwa/docker-compose.yml up -d
# Full walkthrough: infra/openwa/README.md
#
# Off by default. With WHATSAPP_ENABLED unset the app behaves exactly as it did
# before this feature existed, and the Settings page explains what to set.
WHATSAPP_ENABLED=false

# Where the gateway listens. The default matches infra/openwa/docker-compose.yml.
WHATSAPP_API_URL=http://localhost:2785

# An API key from the gateway (its dashboard: Settings -> API keys, or the value
# of API_MASTER_KEY in infra/openwa/.env). Needs the OPERATOR role.
WHATSAPP_API_KEY=

# Shared secret the gateway signs webhook deliveries with, and the only thing
# authenticating /api/whatsapp/webhook. Generate one with:
#   openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=

# How the GATEWAY reaches this app — not how your browser does. Running the
# gateway on the host (see infra/openwa/README.md) this is plain localhost; with
# the gateway in Docker, "localhost" inside the container is the container itself,
# so it must be http://host.docker.internal:3000 (Docker Desktop) or the host's
# LAN address. Defaults to BETTER_AUTH_URL when unset.
WHATSAPP_PUBLIC_URL=http://localhost:3000

# Country code prepended to a local number stored without one (0599… -> 970599…).
WHATSAPP_DEFAULT_COUNTRY_CODE=970

# Bearer token for POST /api/whatsapp/reminders, the reminder tick. Without it
# that route answers 404 and reminders only run via `bun run wa:reminders`.
#   openssl rand -hex 32
WHATSAPP_CRON_SECRET=

# Gateway request timeout in milliseconds. Optional; defaults to 10000.
WHATSAPP_TIMEOUT_MS=10000
