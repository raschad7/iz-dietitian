# Copy to .env.test.local before running tests.
# The safety checks require a database name ending in _test and refuse to use
# the same database configured for normal development.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dietitian_test

# Test-only value. Do not reuse a development or production auth secret.
BETTER_AUTH_SECRET=test-only-secret-at-least-32-characters-long

# Tests do not send real email.
MAIL_TRANSPORT=console
